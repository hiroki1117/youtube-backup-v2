# Example resource references only; never put actual values or credentials in tracked files.
AWS_REGION=us-east-1
DYNAMO_TABLE_NAME=example-video-table
BACKUP_BACKET=example-video-bucket
JOB_QUEUE_NAME=example-job-queue
YTDLP_JOB_DEFINITION_NAME=example-job-definition
YTDLP_JOB_REVISION=1
SSM_YOUTUBE_API_KEY_PARAMETER=/example/youtube-api-key
SSM_PROXY_PATH_PARAMETER=/example/proxy-path
SSM_COOKIE_S3_PATH_PARAMETER=/example/cookie-s3-path
SSM_SCRAPBOX_CREDENTIALS_PARAMETER=/example/scrapbox-credential
SSM_SCRAPBOX_PROJECTS_PARAMETER=/example/scrapbox-projects
# BACKEND_LOCAL_TOKEN is generated at runtime and used only by the local HTTP server.

# Archived maintenance script only; exact non-production prefix to inspect.
BACKUP_S3_PREFIX=s3://example-video-bucket/

# First AWS deployment: no data resources, triggers or application permissions.
# Defaults to validation if omitted. Infra alone enables application after review.
BACKEND_EXECUTION_MODE=validation
