# youtube-backup-front-v2 の環境変数（キー名のみ。値はコミットしない）
# Vite は VITE_* プレフィックスの変数のみをクライアントへ公開する。
# これらは公開前提の構成値（機密ではない）。真の機密はフロントに置かない。

# youtube-backup API のベース URL（Cognito JWT 必須の /videos 系。例: https://api.example.com/v2）。末尾に /videos を付けない
VITE_API_BASE_URL=

# AWS Cognito User Pool 設定
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=
